# Copy to .env and fill in. Never commit the real .env.
ADMIN_PASSWORD=replace-with-a-long-random-password
PORT=3000

# Vercel + Upstash inject these automatically after connecting the integration.
# Either KV_* or UPSTASH_REDIS_REST_* names are supported by the app.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
